# ── Required for Vercel production login ──────────────────────────────
# Neon / Postgres — sessions & alerts must survive serverless restarts
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Fixed secret (any long random string). Without this, OAuth cookies break
# across cold starts. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=generate-a-long-random-string

# Public production URL (your Vercel domain)
BETTER_AUTH_URL=https://price-revisit-analyzer-app.vercel.app
VITE_APP_URL=https://price-revisit-analyzer-app.vercel.app

# ── Recommended: native X / Google OAuth (works on Vercel) ───────────
# Create apps at developer.x.com and console.cloud.google.com
# Callback URLs:
#   https://YOUR-APP.vercel.app/api/auth/callback/twitter
#   https://YOUR-APP.vercel.app/api/auth/callback/google
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: Grok OAuth broker (live preview only by default) ───────
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Email alerts (Resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Market data
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENABLED=true

# Lemon Squeezy (payments)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STORE_SLUG=
PRO_PAYMENT_URL=
PRO_PRICE_LABEL=

PRO_ALLOW_DEMO=false
