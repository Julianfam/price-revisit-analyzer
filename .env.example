# ── Product mode ──────────────────────────────────────────────────────
# Local-first (default ON): full Pro on-device, no login required.
# Set to false only when native OAuth + DATABASE_URL are ready.
VITE_LOCAL_MODE=true

# ── Cloud auth (optional — only if VITE_LOCAL_MODE=false) ─────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://price-revisit-analyzer-app.vercel.app
VITE_APP_URL=https://price-revisit-analyzer-app.vercel.app

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com

ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENABLED=true

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STORE_SLUG=
PRO_PAYMENT_URL=
PRO_PRICE_LABEL=
PRO_ALLOW_DEMO=false
